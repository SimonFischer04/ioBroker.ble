{
  "name": "iobroker.ble2",
  "version": "0.14.2-beta.1",
  "description": "ioBroker adapter to monitor Bluetooth Low Energy (BLE) beacons",
  "author": {
    "name": "SimonFischer04",
    "url": "https://github.com/SimonFischer04"
  },
  "main": "build/main.js",
  "files": [
    "admin/jsonConfig.json",
    "admin/i18n",
    "admin/*.png",
    "build/",
    "io-package.json"
  ],
  "contributors": [
    {
      "name": "AlCalzone",
      "email": "d.griesel@gmx.net"
    },
    "zuvielx9 (https://github.com/zuvielx9)"
  ],
  "homepage": "https://github.com/SimonFischer04/ioBroker.ble2",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "bluetooth",
    "BLE",
    "beacon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SimonFischer04/ioBroker.ble2"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.0.4",
    "@stoprocent/noble": "^1.18.2",
    "alcalzone-shared": "^4.0.8",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "~3.7.0",
    "@alcalzone/release-script-plugin-iobroker": "~3.7.0",
    "@alcalzone/release-script-plugin-license": "~3.7.0",
    "@alcalzone/release-script-plugin-manual-review": "~3.7.0",
    "@iobroker/adapter-dev": "^1.2.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/types": "^5.0.19",
    "@tsconfig/node18": "^18.2.2",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.3",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.2",
    "@types/sinon-chai": "^3.2.12",
    "@types/yargs": "^17.0.32",
    "axios": "^1.6.7",
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.1",
    "esbuild": "^0.19.9",
    "eslint": "^9.39.5",
    "mocha": "^12.0.3",
    "node-gyp": "^10.0.1",
    "nyc": "^15.1.0",
    "prettier": "^3.6.2",
    "proxyquire": "^2.1.3",
    "rimraf": "^5.0.5",
    "sinon": "^17.0.1",
    "sinon-chai": "^3.7.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "prebuild": "rimraf build admin/build",
    "build:ts": "build-adapter ts",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "build-adapter ts",
    "watch:ts": "npm run build:ts -- --watch",
    "watch": "build-adapter ts --watch",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test:unit": "mocha \"src/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:package",
    "test:watch": "npm run test:unit -- --watch",
    "coverage": "nyc npm run test:unit",
    "show-coverage": "npm run coverage & start ./coverage/index.html",
    "lint:ts": "eslint src test/mocks",
    "lint": "eslint .",
    "prepublishOnly": "npm run test:package",
    "translate": "translate-adapter translate",
    "release": "release-script",
    "build:server": "esbuild src/scanProcess.ts --bundle --main-fields=main --outfile=bin/blerp.js --platform=node --format=cjs --target=node14.18 --external:@stoprocent/noble"
  },
  "bugs": {
    "url": "https://github.com/SimonFischer04/ioBroker.ble2/issues"
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "build/**",
      "src/**/*.test.ts",
      "**/*.d.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "text-summary",
      "html",
      "lcov"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "readmeFilename": "README.md"
}
